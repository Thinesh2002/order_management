PORT=5050
NODE_ENV=production

FRONTEND_URL=https://orders.teckvora.com
CORS_ORIGIN=https://orders.teckvora.com,https://system.teckvora.com,http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=db_admin
DB_PASS=Thinesh2002@Admin

DB_NAME=cm_auth_management
AUTH_DB_NAME=cm_auth_management

ORDER_DB_NAME=cm_order_management
INVENTORY_DB_NAME=cm_inventory_management
INVENTORY_STOCK_TABLE=product_inventory
INVENTORY_MOVEMENT_TABLE=inventory_stock_movements
INVENTORY_ALLOW_NEGATIVE_STOCK=false

PM_DB_NAME=cm_product_management
MP_DB_NAME=cm_marketplace_management
LOG_DB_NAME=cm_logs_management
FINANCE_DB_NAME=cm_finance_management

JWT_SECRET=replace_this_with_long_random_secret_key_64_chars_minimum
JWT_EXPIRES_IN=1d

TRANS_EXPRESS_BASE_URL=
TRANS_EXPRESS_API_KEY=
TRANS_EXPRESS_AUTH_HEADER=Authorization
TRANS_EXPRESS_CREATE_ORDER_PATH=/api/order/create
TRANS_EXPRESS_TRACKING_PATH=/api/order/track
TRANS_EXPRESS_TRACKING_METHOD=GET
TRANS_EXPRESS_AUTO_TRACKING=true

ORDER_AUTO_SYNC_ENABLED=true
ORDER_AUTO_SYNC_INTERVAL_MS=600000
ORDER_AUTO_SYNC_START_DELAY_MS=20000
ORDER_SYNC_DAYS_BACK=7
ORDER_SYNC_LIMIT=50

DARAZ_API_BASE_URL=https://api.daraz.lk/rest
DARAZ_ORDERS_GET_PATH=/orders/get
DARAZ_ORDER_ITEMS_GET_PATH=/order/items/get
DARAZ_APP_KEY=
DARAZ_APP_SECRET=
DARAZ_ACCESS_TOKEN=

WOO_STORE_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

MANUAL_ORDER_PREFIX=BH

DARAZ_PACK_PATH=/order/fulfill/pack
DARAZ_RTS_PATH=/order/package/rts
DARAZ_PRINT_AWB_PATH=/order/package/document/get
DARAZ_SET_INVOICE_PATH=/order/invoice_number/set