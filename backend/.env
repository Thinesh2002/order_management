PORT=5050
NODE_ENV=production

# Database credentials are read from server environment or PM2 ecosystem file.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
ORDER_DB_NAME=cm_order_management
PM_DB_NAME=cm_product_management
INVENTORY_DB_NAME=cm_inventory_management
MP_DB_NAME=cm_marketplace_management
AUTH_DB_NAME=cm_auth_management
LOG_DB_NAME=cm_logs_management

# CORS defaults already allow orders.teckvora.com and system.teckvora.com.
# Add extra origins only if needed, comma-separated.
FRONTEND_URL=https://orders.teckvora.com

ORDER_AUTO_SYNC_ENABLED=true
ORDER_AUTO_SYNC_INTERVAL_MS=300000
ORDER_SYNC_DAYS_BACK=7
ORDER_SYNC_LIMIT=50
ORDER_SYNC_MAX_PAGES=5
